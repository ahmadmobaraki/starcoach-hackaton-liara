# Liara API token (console.liara.ir -> API)
LIARA_API_KEY=
# Optional team id; leave empty for personal account
LIARA_TEAM_ID=

# OpenAI-compatible LLM. DeepSeek is the default.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8000
# Optional override for the agent system prompt (default: prompts/raahbar-system.md)
SYSTEM_PROMPT_PATH=

# Public URL used in approval links (no trailing slash)
APP_URL=http://localhost:3000

# Protect the HTTP MCP endpoint. Required if exposed publicly.
MCP_AUTH_TOKEN=

# Storage for sessions, approvals and audit log
DATA_DIR=.data

# Upload limits
MAX_UPLOAD_MB=50

# Approval encryption secret (defaults to LIARA_API_KEY if empty)
APPROVAL_SECRET=

# Set true only when the stdio MCP server may deploy a local directory.
LIARA_MCP_ALLOW_LOCAL_PATHS=false
# Restrict local source paths to this root (defaults to the project directory).
LIARA_MCP_SOURCE_ROOT=
